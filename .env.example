# Default test model is PP-OCRv6_small; switch to medium by changing to medium and re-preparing models.
OCR_MODEL_TIER=small

# Use cpu for macOS development; use gpu:0 for Windows + NVIDIA GPU target environments.
OCR_DEVICE=cpu

# All models are stored in the project directory, skipping online model source detection.
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_PDX_MODEL_SOURCE=bos

# Optional: Override the default .paddlex/official_models.
# OCR_MODEL_DIR=.paddlex/official_models

# Upload and PDF page-by-page processing limits.
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=50
MAX_MULTI_IMAGE_PAGES=50
RETRY_COOLDOWN_SECONDS=60
PDF_RENDER_SCALE=2.0
PDF_MAX_RENDER_PIXELS=40000000
PDF_NATIVE_TEXT_MIN_CHARS=20

# Optional: Local GGUF text organizer model. When empty, model is not loaded, coordinate-based segmentation still works.
# First run `uv sync --extra ai` to install CPU inference dependencies, then manually place the model in local_models/.
# AI_TEXT_MODEL_PATH=local_models/Qwen3-0.6B-Q8_0.gguf
# AI_TEXT_MODEL_NAME=Qwen3-0.6B-Q8_0
# During development, compare saves both full-page grouping and per-boundary judgments; can be changed to page or boundary after finalization.
AI_TEXT_ORGANIZER_MODE=compare
AI_TEXT_MODEL_CONTEXT_SIZE=4096
AI_TEXT_MODEL_THREADS=4
AI_TEXT_MODEL_GPU_LAYERS=0
AI_TEXT_MODEL_MAX_TOKENS=768
AI_TEXT_BOUNDARY_MERGE_THRESHOLD=0.72
AI_TEXT_BOUNDARY_SPLIT_THRESHOLD=0.20
# Coordinate rules: obvious font size changes, title-to-body text, excessive line spacing or horizontal distance will create paragraph breaks.
TEXT_RULE_FONT_HEIGHT_RATIO=1.55
TEXT_RULE_TITLE_BODY_HEIGHT_RATIO=1.18
TEXT_RULE_LINE_STEP_RATIO=2.0
TEXT_RULE_HORIZONTAL_GAP_RATIO=3.0
# Most new GGUF models include chat templates; only configure when custom models cannot detect templates.
# AI_TEXT_MODEL_CHAT_FORMAT=chatml
