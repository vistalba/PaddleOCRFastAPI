# 当前默认测试 PP-OCRv6_small；切换 medium 只需改为 medium 并重新准备模型。
OCR_MODEL_TIER=small

# macOS 开发环境使用 cpu；Windows + NVIDIA GPU 目标环境使用 gpu:0。
OCR_DEVICE=cpu

# 所有模型固定放在项目目录中，并跳过模型源联网探测。
PADDLE_PDX_CACHE_HOME=.paddlex
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
PADDLE_PDX_MODEL_SOURCE=bos

# 可选：覆盖默认的 .paddlex/official_models。
# OCR_MODEL_DIR=.paddlex/official_models

# 上传与 PDF 逐页处理限制。
MAX_UPLOAD_SIZE_MB=50
MAX_PDF_PAGES=50
PDF_RENDER_SCALE=2.0
PDF_MAX_RENDER_PIXELS=40000000
PDF_NATIVE_TEXT_MIN_CHARS=20
